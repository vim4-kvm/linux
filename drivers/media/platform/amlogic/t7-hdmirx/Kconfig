config VIDEO_MESON_T7_HDMIRX
	tristate "Amlogic T7 HDMI receiver bring-up"
	depends on ARCH_MESON || COMPILE_TEST
	depends on PM && DEBUG_FS
	depends on SND_SOC
	help
	  Manage the T7 HDMI receiver power domain and clocks, and expose
	  cable and register status through debugfs. Supports firmware EDID,
	  DDC/HPD, measured progressive input timings and HDMI PCM capture.
	  PHY, HDR and audio paths still require explicit module parameters.
	  The separate VDIN experiment exposes video capture through V4L2.

	  To compile this driver as a module, choose M here.

config VIDEO_MESON_T7_VDIN_TEST
	tristate "Amlogic T7 VDIN capture experiment"
	depends on VIDEO_MESON_T7_HDMIRX
	depends on VIDEO_DEV && OF && HAS_DMA
	select VIDEOBUF2_DMA_CONTIG
	help
	  Progressive RGB or NV12 capture, including measured UHD timings,
	  for the dedicated receiver DTBs. Exposes V4L2 streaming and DMA-buf
	  export with either a private copy ring or leased direct DMA buffers.
	  Owns the VPU register window; only the split-resource profile permits
	  coexistence with the fixed OSD1 display handoff. This experimental
	  resource and DMA ownership model still needs upstream integration.

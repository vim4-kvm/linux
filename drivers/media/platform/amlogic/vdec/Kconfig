config VIDEO_AMLOGIC_VDEC
    tristate "Amlogic Video Decoder Driver"
    depends on ARCH_MESON || COMPILE_TEST
    depends on VIDEO_DEV
    depends on V4L_MEM2MEM_DRIVERS
    select VIDEOBUF2_DMA_CONTIG
    select V4L2_H264
    select V4L2_MEM2MEM_DEV
    select MESON_CANVAS
    select VIDEO_MESON_T7_DOS
    select REGMAP_MMIO
    select DMA_SHARED_BUFFER
    help
      This is a v4l2 driver for Amlogic video decoder driver.
	  This driver is designed to support V4L2 M2M STATELESS
	  interface.
      To compile this driver as a module choose m here.

config VIDEO_AMLOGIC_VDEC_KUNIT_TEST
	tristate "KUnit tests for Amlogic video decoder" if !KUNIT_ALL_TESTS
	depends on KUNIT
	depends on VIDEO_AMLOGIC_VDEC
	default KUNIT_ALL_TESTS
	help
	  Test parameter serialization and arithmetic boundaries without
	  requiring decoder hardware. These tests do not exercise DMA or
	  the firmware protocol.
	  Run the suite with the KUnit executor and the local .kunitconfig.
